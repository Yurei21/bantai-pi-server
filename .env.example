# Cloudflare Realtime SFU credentials. Copy to .env on the Raspberry Pi and fill locally.
# Never commit .env or share its values.
CF_SFU_APP_ID=
CF_SFU_APP_SECRET=
# Optional TURN relay credentials from Cloudflare Realtime. Use comma-separated URLs if supplied.
CF_SFU_TURN_URLS=
CF_SFU_TURN_USERNAME=
CF_SFU_TURN_CREDENTIAL=
